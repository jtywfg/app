{
  "expo": {
    "name": "PinPic",
    "slug": "pinpic-v1",
    "version": "1.2.2",
    "scheme": "pinpic",
    "orientation": "portrait",
    "icon": "./assets/pinpic-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pinpic.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BC54E3",
        "foregroundImage": "./assets/pinpic-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pinpic.app",
      "versionCode": 17,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PinPic 用于拍摄你主动制作的证件照、扫描文档和书籍。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinPic 仅在你选择照片时访问所选图片，用于拼图和编辑。",
          "cameraPermission": "PinPic 使用相机拍照，用于你主动创建的照片编辑和拼图。",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PinPic 用于读取你主动选择的照片。",
          "savePhotosPermission": "PinPic 用于将你制作的图片保存到系统相册。",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71dd3d99-ce5d-4d4d-8633-1f1f821539a8"
      }
    },
    "owner": "nihaoa666s-team"
  }
}
